# Base URL of the ReadAloud TTS API. Leave empty to run without a backend (local voice fallback).
VITE_API_BASE=
# Optional readability proxy used when a page blocks cross-origin fetches. {url} is replaced.
VITE_FETCH_PROXY=https://r.jina.ai/{url}
# Monthly character limit shown in Settings → Usage
VITE_PLAN_LIMIT=1000000
