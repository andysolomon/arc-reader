# ---- Browser-side (bundled; VITE_ prefix) ----
# Base URL the app calls for speech. "/api/vs" is the built-in proxy to VoiceStudio.
# Leave empty to run with the browser's speech engine only.
VITE_API_BASE=/api/vs
# API shape behind VITE_API_BASE: "openai" (VoiceStudio, or any OpenAI-compatible
# speech server) or "readaloud" (the custom /tts contract described in the README).
VITE_TTS_PROVIDER=openai
# Engine the app asks for by default. Must be an id VoiceStudio lists at /v1/models.
VITE_DEFAULT_ENGINE=kittentts
# Optional readability proxy for pages that block cross-origin fetches. {url} is replaced.
VITE_FETCH_PROXY=https://r.jina.ai/{url}
# Monthly character limit shown in Settings → Usage
VITE_PLAN_LIMIT=1000000

# ---- Server-side (read by vite dev / vite preview only; never bundled) ----
# Where VoiceStudio listens. Keep it on loopback; the proxy is its only caller.
VOICESTUDIO_URL=http://127.0.0.1:3900
# The OMNIVOICE_API_KEY you started the container with.
VOICESTUDIO_API_KEY=
