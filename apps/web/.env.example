# ---- Browser-side (bundled; VITE_ prefix) ----
# Base URL the app calls for speech. "/api/vs" is the built-in proxy to VoiceStudio.
# Leave empty to run with the browser's speech engine only.
# An iOS app that runs its own files ignores a relative value (there is no Vite proxy
# in the bundle) and reads with the on-device voice unless Settings → Speech server has
# an absolute URL. One that loads from READALOUD_PUBLIC_URL uses the proxy like a browser.
VITE_API_BASE=/api/vs
# API shape behind VITE_API_BASE: "openai" (VoiceStudio, or any OpenAI-compatible
# speech server) or "readaloud" (the custom /tts contract described in the README).
VITE_TTS_PROVIDER=openai
# Engine the app asks for by default. Must be an id VoiceStudio lists at /v1/models.
VITE_DEFAULT_ENGINE=kittentts
# Last-resort readability proxy, tried after the built-in /api/fetch route (only needed
# when the build is served without vite dev/preview). {url} is replaced.
VITE_FETCH_PROXY=https://r.jina.ai/{url}
# Monthly character limit shown in Settings → Usage
VITE_PLAN_LIMIT=1000000

# OpenAI voices (the ChatGPT voices). "/api/oa" is the built-in proxy; leave empty to hide them.
VITE_OPENAI_BASE=/api/oa
# Speech model for OpenAI voices: gpt-4o-mini-tts (cheapest, accepts style instructions), tts-1 or tts-1-hd.
VITE_OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Text model for English-to-Jamaican-Patois adaptation (uses the same OpenAI proxy/key).
VITE_PATOIS_MODEL=gpt-4.1-mini

# Vision model for article images and diagrams through the LLM connection (Responses API).
VITE_VISUAL_MODEL=muse-spark-1.3-contributor

# Fish Audio: set /api/fish to show Fish voices, or leave empty to hide them.
VITE_FISH_BASE=
VITE_FISH_TTS_MODEL=s2.1-pro

# ---- Deployment and the iOS app ----
# The address the app is opened at, e.g. https://<machine>.<tailnet>.ts.net:8449.
# The kind deployment has Tailscale serve the app there and checks it after each deploy.
# `ios:sync` builds an iOS app that loads the web app from it, so deploys reach the
# phone without a rebuild. Leave empty for an iOS app that runs its own bundled files.
READALOUD_PUBLIC_URL=

# ---- Server-side (read by vite dev / vite preview only; never bundled) ----
# Preferred preparation machine (Mac mini when using both machines).
# Where VoiceStudio listens; the proxy is its only caller.
VOICESTUDIO_URL=http://127.0.0.1:3900
# Docker Compose only: a VoiceStudio on another machine (e.g. https://mac.tailnet.ts.net:3900).
# Unset, the web container uses the Compose VoiceStudio.
VOICESTUDIO_REMOTE_URL=
# The OMNIVOICE_API_KEY you started the container with.
VOICESTUDIO_API_KEY=
# Names shown beside active Library preparation jobs.
VOICESTUDIO_NAME=VoiceStudio
# Optional overflow preparation machine, used only while the primary is occupied.
# Use the host's loopback URL for dev/preview;
# Compose automatically uses its local VoiceStudio when the primary is remote.
VOICESTUDIO_SECONDARY_URL=
VOICESTUDIO_SECONDARY_NAME=Omarchy
# Leave empty to use the primary machine's API key.
VOICESTUDIO_SECONDARY_API_KEY=
# Compose only: override the automatic http://voicestudio:3900 secondary address.
VOICESTUDIO_SECONDARY_REMOTE_URL=
# Persistent server-side preparation jobs and audio (defaults to .readaloud-preparations).
# Docker Compose sets this to its preparation-data volume automatically.
PREPARATION_DATA_DIR=
# How long background preparation stays paused after the last live speech request
# (a reader or voice preview) to the same VoiceStudio. Defaults to 15000 ms.
PREPARATION_YIELD_MS=
# Shared documents and listening progress (defaults to .readaloud-library; no expiry).
# Use the same persistent directory when moving between checkouts.
LIBRARY_DATA_DIR=
# OpenAI API key with billing enabled. Only read by the proxy.
OPENAI_API_KEY=
# Override to point the OpenAI route at a compatible server.
OPENAI_URL=https://api.openai.com
# Fish Audio API key. Server-only; never use a VITE_ prefix for credentials.
FISH_API_KEY=
# Optional OpenCode Go API key for article summaries. Usually entered in Settings → Summaries
# instead, which saves it on this server and takes precedence. Server-only.
LLM_API_KEY=
# Override to use another OpenAI-compatible server (e.g. https://opencode.ai/zen for Zen).
LLM_URL=https://opencode.ai/zen/go
# Optional TypeSafe API key for Jev, which files documents into library categories. Usually
# entered in Settings → Library instead, which saves it on this server and takes precedence.
TYPESAFE_API_KEY=
