{
  "name": "readaloud",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm --filter @readaloud/web dev",
    "build": "pnpm -r --filter './packages/**' build && pnpm --filter @readaloud/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @readaloud/web test:e2e",
    "storybook": "pnpm --filter @readaloud/ui storybook",
    "contrast": "pnpm --filter @readaloud/tokens contrast"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
