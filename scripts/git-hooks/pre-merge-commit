#!/bin/sh
# A merge into main in the main checkout deploys at once (the post-merge hook), so it runs the
# same checks as CI first. Branches and worktrees merge freely.
[ "$(git rev-parse --abbrev-ref HEAD)" = main ] || exit 0
[ "$(git rev-parse --git-dir)" = "$(git rev-parse --git-common-dir)" ] || exit 0
echo "pre-merge-commit: running pnpm check before merging into main" >&2
pnpm --silent check >"$(git rev-parse --git-dir)/pre-merge-check.log" 2>&1 && exit 0
tail -40 "$(git rev-parse --git-dir)/pre-merge-check.log" >&2
echo "pre-merge-commit: pnpm check failed, so nothing was merged or deployed. Run \`git merge --abort\` here to put main back, fix the branch, and merge again. Full log: $(git rev-parse --git-dir)/pre-merge-check.log" >&2
exit 1
